# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# --- API keys dos providers (MVP: só estes 3) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Banco de dados (padrão: SQLite local, não precisa mudar no MVP) ---
DATABASE_URL=sqlite+aiosqlite:///./llm_council.db

# --- Limites padrão de execução -- Settings é a ÚNICA fonte destes
# valores: a API de criação de run (POST /runs) NÃO aceita override por
# request (question/enabled_providers/source_text são os únicos campos
# de entrada aceitos; tudo o resto de RunConfig vem sempre daqui) ---
DEFAULT_MAX_COST_USD=1.00
# Orçamento AGREGADO de tokens da execução inteira (soma de input+output
# de todos os providers) -- SOFT CAP, não uma reserva rígida: nunca
# limita/cancela uma chamada já em andamento; é checado DEPOIS que o
# trabalho já disparado termina, e só então bloqueia o que ainda não
# começou, uma vez que o uso já conhecido atinja este valor. A execução
# pode legitimamente terminar acima deste número (o trabalho em voo no
# momento em que o teto é atingido sempre é deixado terminar):
DEFAULT_MAX_TOTAL_TOKENS=150000
# Teto de output de UMA chamada a UM provider (participante do debate,
# extração de claims, crítica), repassado a cada request individual
# (Etapa 17A.1 -- elevado de 1024 pra 4096; 1024 provou insuficiente em
# Runs reais, causando truncamento visível de respostas de participante
# e do próprio Judge):
DEFAULT_MAX_OUTPUT_TOKENS_PER_CALL=4096
# HISTÓRICO / compatibilidade: era o teto de output do agrupamento e da
# reconciliação cross-round de claims, operações que NÃO são mais executadas.
# Nenhuma chamada atual usa este valor; ele só é mantido pra que
# configurações existentes e runs antigas continuem válidas (fica gravado na
# configuração da run). Não é preciso configurá-lo:
DEFAULT_MAX_OUTPUT_TOKENS_GROUPING=8192
# Teto de output PRÓPRIO da chamada do Judge (Etapa 17A.2) -- distinto do
# teto genérico acima porque o Judge precisa cobrir exatamente uma avaliação
# por claim atual, então o output mínimo exigido cresce com a contagem de
# claims:
DEFAULT_MAX_OUTPUT_TOKENS_JUDGE=8192

# --- Claim processor (Etapa 5): provider que faz a extração de claims ---
DEFAULT_CLAIM_PROCESSOR_PROVIDER=anthropic

# --- Judge (Etapa 6) ---
DEFAULT_JUDGE_PROVIDER=anthropic

# --- Editor (Etapa 7) ---
DEFAULT_EDITOR_PROVIDER=anthropic

# --- Quórum: únicos valores canônicos (QuorumPolicy é sempre construída a partir daqui) ---
QUORUM_MIN_FOR_DEBATE=2
QUORUM_MIN_TO_RETURN=1

# --- Timeout/retry por chamada a provider ---
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2

# --- Política de transporte só do Judge (deployment-only, não é knob de run) ---
JUDGE_PROVIDER_TIMEOUT_SECONDS=120
JUDGE_PROVIDER_MAX_TRANSPORT_ATTEMPTS=1

# --- Timeout de dispatch de UMA rodada de providers em paralelo (rodada
# inicial ou de crítica, reinicia a cada uma), além do timeout por
# provider -- NÃO é um prazo pra execução inteira do Council. Nome
# antigo ORCHESTRATOR_OVERALL_TIMEOUT_SECONDS ainda é aceito como alias
# de compatibilidade se você já tem essa variável configurada.
ORCHESTRATOR_ROUND_DISPATCH_TIMEOUT_SECONDS=120.0

LOG_LEVEL=INFO
