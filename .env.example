# Copie este arquivo para .env e preencha com suas chaves reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# --- API keys dos providers (MVP: só estes 3) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Banco de dados (padrão: SQLite local, não precisa mudar no MVP) ---
DATABASE_URL=sqlite+aiosqlite:///./llm_council.db

# --- Limites padrão (podem ser sobrescritos por execução, via API) ---
DEFAULT_MAX_COST_USD=1.00
# Orçamento AGREGADO da execução (soma de todos os providers), checado
# depois que as respostas chegam:
DEFAULT_MAX_TOTAL_TOKENS=50000
# Teto de output de UMA chamada a UM provider, repassado a cada request
# (Etapa 17A.1 -- elevado de 1024 pra 4096; 1024 provou insuficiente em
# Runs reais, causando truncamento visível de respostas de participante
# e do próprio Judge):
DEFAULT_MAX_OUTPUT_TOKENS_PER_CALL=4096

# --- Claim processor (Etapa 5): mesmo provider faz extração E agrupamento ---
DEFAULT_CLAIM_PROCESSOR_PROVIDER=anthropic

# --- Judge (Etapa 6) ---
DEFAULT_JUDGE_PROVIDER=anthropic

# --- Editor (Etapa 7) ---
DEFAULT_EDITOR_PROVIDER=anthropic

# --- Quórum: únicos valores canônicos (QuorumPolicy é sempre construída a partir daqui) ---
QUORUM_MIN_FOR_DEBATE=2
QUORUM_MIN_TO_RETURN=1

# --- Timeout/retry por chamada a provider ---
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=2

# --- Timeout de dispatch de UMA rodada de providers em paralelo (rodada
# inicial ou de crítica, reinicia a cada uma), além do timeout por
# provider -- NÃO é um prazo pra execução inteira do Council. Nome
# antigo ORCHESTRATOR_OVERALL_TIMEOUT_SECONDS ainda é aceito como alias
# de compatibilidade se você já tem essa variável configurada.
ORCHESTRATOR_ROUND_DISPATCH_TIMEOUT_SECONDS=120.0

LOG_LEVEL=INFO
